# Copy this file to .env and fill in your own values. Never commit .env.

# Demo agent
AGENT_NAME=Jamie

# LLM backend: gemini or groq
LLM_BACKEND=gemini
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Speech-to-text
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# Text-to-speech: Cartesia if configured, otherwise Deepgram
DEEPGRAM_TTS_VOICE=aura-2-luna-en
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
